# Produção: use uma URL secreta fornecida pelo seu PostgreSQL.
DATABASE_URL=postgresql://usuario:senha-ficticia@host.exemplo:5432/adota_pet?sslmode=require

# Desenvolvimento local com Docker Compose (valores fictícios e seguros).
DB_DRIVER=mysql
DB_HOST=database
DB_PORT=3306
DB_NAME=adota_pet
DB_USER=adota_pet
DB_PASS=senha-local-ficticia
DB_ROOT_PASS=senha-root-local-ficticia

PORT=8080
RUN_MIGRATIONS=1
